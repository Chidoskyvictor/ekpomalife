NODE_ENV=development
DATABASE_URL=postgresql://ekpoma:ekpoma@localhost:5432/ekpoma_life
# Neon: pooled app URL + direct URL for migrations (`neon env pull` writes both to repo root `.env`)
# DATABASE_URL_UNPOOLED=postgresql://...
PORT=4000

# Comma-separated — production must be exactly the Pages origins:
# FRONTEND_ORIGIN=https://ekpomalife.app,https://www.ekpomalife.app
FRONTEND_ORIGIN=http://localhost:3000,http://192.168.0.199:3000,http://192.168.0.200:3000

# Required in production (openssl rand -hex 32). Peppers el_session token hashes.
SESSION_SECRET=change-me-to-a-long-random-string

# Legacy — cookies follow NODE_ENV (prod: Secure + Domain=.ekpomalife.app).
COOKIE_SECURE=false

# Password reset email — Resend OR SMTP
RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Ekpoma Life <noreply@mail.ekpomalife.app>
RESET_CODE_PEPPER=change-me-to-a-long-random-string

# Optional: force SSL to Postgres outside production (Neon local testing)
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false

# Comma-separated IPs that skip rate limits (load testing only). Leave empty.
RATE_LIMIT_ALLOWLIST=

# Phase 4: allow GET /room/:username for other players (default off)
# ROOM_VISITS_ENABLED=false

# Campus Spaces (live voice rooms) — LiveKit Cloud project keys. Audio never touches
# this server and is never recorded (no egress). Leave empty to disable joining.
LIVEKIT_URL=
# LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Participant-minutes (people × minutes, how LiveKit bills) all Spaces may use per Lagos day.
# 160 × 31 = 4,960 fits the LiveKit free plan (5,000/month, hard cap). Raise on a paid plan.
SPACES_DAILY_MINUTES=160
# Usernames (comma-separated) who can open /admin/spaces to review reports
ADMIN_USERNAMES=
# Point the LiveKit project webhook at https://<api-host>/spaces/livekit-webhook
