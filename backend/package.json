{
  "name": "ekpoma-life-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "test": "vitest run",
    "test:legacy": "tsx src/game/run-tests.ts",
    "test:watch": "vitest",
    "test:node": "tsx src/game/run-tests.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@opennextjs/cloudflare": "^1.20.12",
    "argon2": "^0.45.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "whot": "^1.0.8-alpha-9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
