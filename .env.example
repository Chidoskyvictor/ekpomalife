# Backend the Next /api proxy talks to (server-side only). Browser always calls /api/* same-origin.
API_PROXY_TARGET=http://192.168.0.200:4000

# Legacy alias — used as proxy target if API_PROXY_TARGET is unset.
NEXT_PUBLIC_API_URL=http://192.168.0.200:4000

# Do NOT set this for phone LAN — it bypasses the proxy and breaks el_session cookies.
# NEXT_PUBLIC_API_DIRECT_URL=http://192.168.0.200:4000
