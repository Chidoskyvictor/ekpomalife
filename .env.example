# === Local / LAN (dev) ===
# Next /api proxy target (server-side only). Browser calls /api/* same-origin.
API_PROXY_TARGET=http://127.0.0.1:4000

# Used as proxy fallback in dev. In production set to the public API host.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Economy / game mocks. Keep false for real backend.
NEXT_PUBLIC_USE_MOCKS=false

# Do NOT set on phone LAN — bypasses the proxy and breaks cookies.
# NEXT_PUBLIC_API_DIRECT_URL=http://127.0.0.1:4000

# === Production (Cloudflare / OpenNext) ===
# NEXT_PUBLIC_API_URL=https://api.ekpomalife.app
# NEXT_PUBLIC_USE_MOCKS=false
# (Do not set API_PROXY_TARGET in production — the /api proxy is disabled.)
