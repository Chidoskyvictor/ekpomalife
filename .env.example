# Backend the Next rewrite proxies to (server-side). Browser calls /api/* same-origin.
API_PROXY_TARGET=http://192.168.0.200:4000

# Legacy alias — still used as rewrite target if API_PROXY_TARGET is unset.
NEXT_PUBLIC_API_URL=http://192.168.0.200:4000

# Optional: force the browser to call the API host directly (breaks cookies on mobile LAN).
# NEXT_PUBLIC_API_DIRECT_URL=http://192.168.0.200:4000
