# Backend the Next /api proxy talks to (server-side only). Browser always calls /api/* same-origin.
API_PROXY_TARGET=http://127.0.0.1:4000

# Public API base (also used as proxy target if API_PROXY_TARGET is unset).
# Local: backend host:port. Production Pages: https://api.ekpomalife.app
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Do NOT set this for phone LAN — it bypasses the proxy and breaks el_session cookies.
# NEXT_PUBLIC_API_DIRECT_URL=http://127.0.0.1:4000

# Economy / game mocks (in-process). Off by default — real backend only.
# Set true for offline UI work or Vitest. MSW handlers live in lib/game/economy-msw.ts.
NEXT_PUBLIC_USE_MOCKS=false

# Legacy alias for NEXT_PUBLIC_USE_MOCKS (1 = on). Prefer USE_MOCKS.
# NEXT_PUBLIC_USE_ECONOMY_MOCK=1
