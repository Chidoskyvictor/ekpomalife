# Static files (Workers Assets) skip the Worker, so next.config headers() don't reach them.
# Pages get the full set, including CSP, from next.config.mjs.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# The Snooker table is a static page the phone loads in an iframe, so it must be framable by this site.
/games/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Pictures, sounds and textures: keep them on the phone for a week (and show the saved copy while a
# newer one is fetched) instead of asking the server again every time the app opens. Changed files
# need a new name or a ?v= bump to reach players sooner.
/apps/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/textures/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/emoji/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/stickers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/ads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
